---
const links = [
  { label: "Home", target: "home" },
  { label: "Services", target: "services" },
  { label: "Experience Audit", target: "experience-audit" },
  { label: "About", target: "about" },
  { label: "Contact", target: "contact" },
];

const cta = { label: "Let's Talk", target: "contact" };
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-canvas"
>
  <div class="site-container flex h-20 items-center justify-between">
    <!-- Logo -->
    <a
      href="/#home"
      class="flex items-center gap-3"
      aria-label="Go to Home"
    >
      <img
        src="/images/elevate.PNG"
        alt="Elevate Your Divine logo"
        class="nav-logo h-16 w-auto max-w-[190px] object-contain"
        loading="eager"
      />
    </a>

    <!-- Desktop nav (shows when there's space) -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {
        links.map((l) => (
          <a
            href={`/#${l.target}`}
            class="btn-ghost"
          >
            {l.label}
          </a>
        ))
      }

      <a href={`/#${cta.target}`} class="btn-solid">
        {cta.label}
      </a>
    </nav>

    <!-- Mobile/Collapsed nav -->
    <div class="lg:hidden">
      <button
        id="navMenuBtn"
        type="button"
        class="inline-flex items-center justify-center border border-line bg-surface p-3 text-ink transition hover:border-ink/50 focus:outline-none"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="navMenuPanel"
      >
        <!-- Hamburger icon -->
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Dropdown panel -->
      <div
        id="navMenuPanel"
        class="pointer-events-none absolute right-5 top-20 mt-3 w-[min(92vw,360px)] origin-top-right scale-95 opacity-0 transition duration-150 sm:right-8"
        role="dialog"
        aria-label="Navigation menu"
      >
        <div
          class="border border-line bg-surface p-3 shadow-[0_16px_40px_rgb(32_33_29_/_0.12)]"
        >
          <div class="grid gap-2">
            {
              links.map((l) => (
                <a
                  href={`/#${l.target}`}
                  data-mobile-nav-link
                  class="w-full border-b border-line px-3 py-3 text-left text-xs font-bold uppercase tracking-[0.12em] text-ink transition hover:text-accent-dark focus:outline-none"
                >
                  {l.label}
                </a>
              ))
            }

            <a
              href={`/#${cta.target}`}
              data-mobile-nav-link
              class="btn-solid mt-2 w-full"
            >
              {cta.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const btn = document.getElementById("navMenuBtn");
      const panel = document.getElementById("navMenuPanel");
      if (!btn || !panel) return;

      const open = () => {
        btn.setAttribute("aria-expanded", "true");
        panel.classList.remove("pointer-events-none", "opacity-0", "scale-95");
        panel.classList.add("pointer-events-auto", "opacity-100", "scale-100");
      };

      const close = () => {
        btn.setAttribute("aria-expanded", "false");
        panel.classList.add("pointer-events-none", "opacity-0", "scale-95");
        panel.classList.remove(
          "pointer-events-auto",
          "opacity-100",
          "scale-100",
        );
      };

      const isOpen = () => btn.getAttribute("aria-expanded") === "true";

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        isOpen() ? close() : open();
      });

      // Close when clicking outside
      document.addEventListener("click", (e) => {
        if (!isOpen()) return;
        const t = e.target;
        if (t && (panel.contains(t) || btn.contains(t))) return;
        close();
      });

      // Close on Escape
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });

      // Close when selecting a nav item (so menu collapses after navigation)
      panel.addEventListener("click", (e) => {
        const navBtn = e.target.closest("[data-mobile-nav-link]");
        if (!navBtn) return;
        close();
      });

      // If viewport grows to desktop, ensure panel is closed
      const mq = window.matchMedia("(min-width: 1024px)"); // lg breakpoint
      mq.addEventListener("change", (ev) => {
        if (ev.matches) close();
      });
    })();
  </script>

</header>
