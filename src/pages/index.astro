---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Business Consulting | Elevate Your Divine"
  description="Elevate Your Divine helps businesses strengthen their digital presence, customer experience, and teams through intentional consulting."
>
  <Navbar />

  <main class="mx-auto max-w-6xl px-4 pt-24 md:pt-16">
    <section id="home" class="py-14 md:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold tracking-wide text-zinc-300">Elevate Your Divine, LLC</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white md:text-5xl">Elevate Your Business. Intentionally.</h1>
          <p class="mt-4 text-lg text-zinc-200">Business. Experience. Excellence.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="#services" class="btn-ghost">Explore Services</a>
            <a href="#contact" class="btn-solid">Let's Talk About Your Business</a>
          </div>
        </div>

        <div class="panel overflow-hidden aspect-[4/3]">
          <img src="/images/christyHero.JPG" alt="Elevate Your Divine business consulting" class="h-full w-full object-cover" loading="eager" />
          <div class="absolute inset-0 bg-black/10"></div>
        </div>
      </div>
    </section>

    <section id="services" class="border-t border-white/10 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wide text-zinc-300">Services</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">How we help businesses look, operate, and serve.</h2>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article class="panel panel-pad">
          <p class="text-sm font-semibold text-zinc-300">01</p>
          <h3 class="mt-3 text-xl font-semibold text-white">Digital Presence</h3>
          <p class="mt-2 text-zinc-200">Web design, development, and strategic digital reviews.</p>
        </article>
        <article class="panel panel-pad">
          <p class="text-sm font-semibold text-zinc-300">02</p>
          <h3 class="mt-3 text-xl font-semibold text-white">Customer Experience</h3>
          <p class="mt-2 text-zinc-200">Clear insight into the experience your customers actually receive.</p>
        </article>
        <article class="panel panel-pad">
          <p class="text-sm font-semibold text-zinc-300">03</p>
          <h3 class="mt-3 text-xl font-semibold text-white">People &amp; Performance</h3>
          <p class="mt-2 text-zinc-200">Training and leadership support for teams built to deliver.</p>
        </article>
      </div>
    </section>

    <section id="experience-audit" class="border-t border-white/10 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wide text-zinc-300">Experience Audit</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">The Elevate Business Experience Audit™</h2>
        <p class="mt-4 text-zinc-200">A strategic assessment of the digital, customer, people, and leadership areas that shape your business experience.</p>
      </div>
    </section>

    <section id="about" class="border-t border-white/10 py-14 md:py-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="text-sm font-semibold tracking-wide text-zinc-300">About</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">Businesses are built by people.</h2>
          <p class="mt-4 max-w-xl text-zinc-300">Elevate Your Divine helps businesses bring together their digital presence, customer experience, teams, and leadership with greater intention.</p>
        </div>

        <div class="panel overflow-hidden">
          <div class="relative aspect-[4/5] w-full">
            <img src="/images/ownerPhoto.jpg" alt="Elevate Your Divine founder" class="h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-black/5"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="border-t border-white/10 py-14 md:py-20">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold tracking-wide text-zinc-300">Contact</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">Let's Talk About Your Business</h2>
          <p class="mt-3 text-muted">Tell us how we can help, and we'll respond soon.</p>

          <div class="mt-6 panel panel-pad">
            <p class="text-sm font-semibold text-zinc-200">Email</p>
            <a href="mailto:ELEVATEYOURDIVINE@OUTLOOK.COM?subject=Business%20Consultation%20Request" class="mt-1 inline-block text-white underline decoration-white/30 underline-offset-4 hover:decoration-white/60">ELEVATEYOURDIVINE@OUTLOOK.COM</a>
          </div>
        </div>

        <form name="free-consultation" id="consultation-form" method="POST" action="/thank-you/" data-netlify="true" data-netlify-recaptcha="true" netlify-honeypot="bot-field" class="panel panel-pad">
          <input type="hidden" name="form-name" value="free-consultation" />

          <p class="hidden">
            <label>Don't fill this out if you're human:<input name="bot-field" /></label>
          </p>

          <h3 class="text-xl font-semibold text-white">Start a Conversation</h3>

          <div class="mt-5 grid gap-4">
            <label class="grid gap-1">
              <span class="text-sm font-medium text-zinc-200">Name</span>
              <input class="rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-white placeholder:text-white/40 outline-none focus:border-white/40" name="name" placeholder="Your name" required />
            </label>
            <label class="grid gap-1">
              <span class="text-sm font-medium text-zinc-200">Email</span>
              <input class="rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-white placeholder:text-white/40 outline-none focus:border-white/40" name="email" type="email" placeholder="you@example.com" required />
            </label>
            <label class="grid gap-1">
              <span class="text-sm font-medium text-zinc-200">Phone</span>
              <input class="rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-white placeholder:text-white/40 outline-none focus:border-white/40" name="phone" placeholder="(555) 555-5555" />
            </label>
            <label class="grid gap-1">
              <span class="text-sm font-medium text-zinc-200">Message</span>
              <textarea class="min-h-[120px] rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-white placeholder:text-white/40 outline-none focus:border-white/40" name="message" placeholder="How can we help?" required></textarea>
            </label>
            <div data-netlify-recaptcha="true"></div>
            <button type="submit" class="btn-solid">Send</button>
          </div>
        </form>
      </div>
    </section>

    <Footer />
  </main>

  <script is:inline>
    function fireEvent(name, params) {
      if (typeof window !== "undefined" && typeof window.gtag === "function") {
        window.gtag("event", name, params || {});
      }
    }

    const form = document.getElementById("consultation-form");
    if (form) {
      form.addEventListener("submit", () => {
        fireEvent("generate_lead", { form_id: "consultation-form" });
      });
    }
  </script>
</BaseLayout>
