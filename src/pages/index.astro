---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Business Consulting | Elevate Your Divine"
  description="Elevate Your Divine helps businesses strengthen their digital presence, customer experience, and teams through intentional consulting."
>
  <Navbar />

  <main class="site-container pt-32 md:pt-36">
    <section id="home" class="section-space pt-8 md:pt-12">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Elevate Your Divine, LLC</p>
          <h1 class="mt-4 text-5xl md:text-7xl">Elevate Your Business. Intentionally.</h1>
          <p class="mt-5 text-lg leading-8 text-ink-muted">Business. Experience. Excellence.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="#services" class="btn-ghost">Explore Services</a>
            <a href="#contact" class="btn-solid">Let's Talk About Your Business</a>
          </div>
        </div>

        <div class="panel overflow-hidden aspect-[4/3]">
          <img src="/images/christyHero.JPG" alt="Elevate Your Divine business consulting" class="h-full w-full object-cover" loading="eager" />
        </div>
      </div>
    </section>

    <section id="services" class="section-space border-t border-line">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Services</p>
        <h2 class="mt-4 text-4xl md:text-5xl">How we help businesses look, operate, and serve.</h2>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article class="panel panel-pad">
          <p class="text-xs font-bold tracking-[0.16em] text-accent-dark">01</p>
          <h3 class="mt-4 text-2xl">Digital Presence</h3>
          <p class="mt-3 leading-7 text-ink-muted">Web design, development, and strategic digital reviews.</p>
        </article>
        <article class="panel panel-pad">
          <p class="text-xs font-bold tracking-[0.16em] text-accent-dark">02</p>
          <h3 class="mt-4 text-2xl">Customer Experience</h3>
          <p class="mt-3 leading-7 text-ink-muted">Clear insight into the experience your customers actually receive.</p>
        </article>
        <article class="panel panel-pad">
          <p class="text-xs font-bold tracking-[0.16em] text-accent-dark">03</p>
          <h3 class="mt-4 text-2xl">People &amp; Performance</h3>
          <p class="mt-3 leading-7 text-ink-muted">Training and leadership support for teams built to deliver.</p>
        </article>
      </div>
    </section>

    <section id="experience-audit" class="section-space border-t border-line">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Experience Audit</p>
        <h2 class="mt-4 text-4xl md:text-5xl">The Elevate Business Experience Audit™</h2>
        <p class="mt-5 leading-8 text-ink-muted">A strategic assessment of the digital, customer, people, and leadership areas that shape your business experience.</p>
      </div>
    </section>

    <section id="about" class="section-space border-t border-line">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">About</p>
          <h2 class="mt-4 text-4xl md:text-5xl">Businesses are built by people.</h2>
          <p class="mt-5 max-w-xl leading-8 text-ink-muted">Elevate Your Divine helps businesses bring together their digital presence, customer experience, teams, and leadership with greater intention.</p>
        </div>

        <div class="panel overflow-hidden">
          <div class="relative aspect-[4/5] w-full">
            <img src="/images/ownerPhoto.jpg" alt="Elevate Your Divine founder" class="h-full w-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section-space border-t border-line">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-dark">Contact</p>
          <h2 class="mt-4 text-4xl md:text-5xl">Let's Talk About Your Business</h2>
          <p class="mt-3 text-muted">Tell us how we can help, and we'll respond soon.</p>

          <div class="mt-6 panel panel-pad">
            <p class="text-sm font-semibold text-ink-muted">Email</p>
            <a href="mailto:ELEVATEYOURDIVINE@OUTLOOK.COM?subject=Business%20Consultation%20Request" class="mt-1 inline-block font-semibold text-ink underline decoration-accent underline-offset-4 hover:text-accent-dark">ELEVATEYOURDIVINE@OUTLOOK.COM</a>
          </div>
        </div>

        <form name="free-consultation" id="consultation-form" method="POST" action="/thank-you/" data-netlify="true" data-netlify-recaptcha="true" netlify-honeypot="bot-field" class="panel panel-pad">
          <input type="hidden" name="form-name" value="free-consultation" />

          <p class="hidden">
            <label>Don't fill this out if you're human:<input name="bot-field" /></label>
          </p>

          <h3 class="text-3xl">Start a Conversation</h3>

          <div class="mt-5 grid gap-4">
            <label class="grid gap-1">
              <span class="text-sm font-semibold text-ink">Name</span>
              <input class="border border-line bg-surface px-4 py-3 text-ink placeholder:text-ink-muted outline-none focus:border-accent" name="name" placeholder="Your name" required />
            </label>
            <label class="grid gap-1">
              <span class="text-sm font-semibold text-ink">Email</span>
              <input class="border border-line bg-surface px-4 py-3 text-ink placeholder:text-ink-muted outline-none focus:border-accent" name="email" type="email" placeholder="you@example.com" required />
            </label>
            <label class="grid gap-1">
              <span class="text-sm font-semibold text-ink">Phone</span>
              <input class="border border-line bg-surface px-4 py-3 text-ink placeholder:text-ink-muted outline-none focus:border-accent" name="phone" placeholder="(555) 555-5555" />
            </label>
            <label class="grid gap-1">
              <span class="text-sm font-semibold text-ink">Message</span>
              <textarea class="min-h-[120px] border border-line bg-surface px-4 py-3 text-ink placeholder:text-ink-muted outline-none focus:border-accent" name="message" placeholder="How can we help?" required></textarea>
            </label>
            <div data-netlify-recaptcha="true"></div>
            <button type="submit" class="btn-solid">Send</button>
          </div>
        </form>
      </div>
    </section>

    <Footer />
  </main>

  <script is:inline>
    function fireEvent(name, params) {
      if (typeof window !== "undefined" && typeof window.gtag === "function") {
        window.gtag("event", name, params || {});
      }
    }

    const form = document.getElementById("consultation-form");
    if (form) {
      form.addEventListener("submit", () => {
        fireEvent("generate_lead", { form_id: "consultation-form" });
      });
    }
  </script>
</BaseLayout>
